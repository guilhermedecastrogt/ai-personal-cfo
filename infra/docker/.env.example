CFO_DOMAIN=cfo.example.com
ACME_EMAIL=you@example.com

API_IMAGE=ghcr.io/your-github-user/ai-personal-cfo-api
WEB_IMAGE=ghcr.io/your-github-user/ai-personal-cfo-web

POSTGRES_USER=cfo_app
POSTGRES_PASSWORD=replace-with-a-long-random-password-of-letters-and-digits
POSTGRES_DB=cfo

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
AI_CONFIDENCE_THRESHOLD=0.8

KAPSO_API_KEY=replace-with-your-kapso-api-key
KAPSO_WEBHOOK_SECRET=replace-with-your-kapso-webhook-secret
KAPSO_PHONE_NUMBER_ID=000000000000000

PROACTIVE_EVALUATION_ENABLED=false
PROACTIVE_AI_MESSAGES=false
LOG_LEVEL=log

BACKUP_DIR=/var/backups/ai-personal-cfo
BACKUP_RETENTION_DAYS=14
BACKUP_UPLOAD_URL=
